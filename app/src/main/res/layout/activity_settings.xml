<?xml version="1.0" encoding="utf-8"?>
<!--
  Device settings for one till.

  Grouped by the thing being set up rather than by widget type, most-touched
  first: card payments and the printer are what staff actually come here for,
  the POS address and keys are commissioning-time settings and live at the
  bottom. Values are shown as read-only rows with an Edit button; each dialog
  saves on its own, so there is no "did that save?" moment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="2dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ Card payments ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="Card payments" />

                    <TextView
                        android:id="@+id/tvSumUpStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="15sp"
                        android:text="Checking…" />

                    <TextView
                        android:id="@+id/tvCardReaderStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="15sp"
                        android:text="Card reader: checking…" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSumUpCardReader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pair card reader" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSumUpLogin"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sign in to SumUp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Receipt printer ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="Receipt printer" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvPrinterName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="Not set up" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetupPrinter"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set up" />

                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCashDrawer"
                        style="@style/SettingsSwitch"
                        android:text="Cash drawer attached" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPaperCutter"
                        style="@style/SettingsSwitch"
                        android:text="Printer cuts the paper" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Receipts ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="Receipts" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoPrintCard"
                        style="@style/SettingsSwitch"
                        android:layout_marginTop="8dp"
                        android:text="Print after a card sale" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoPrintCash"
                        style="@style/SettingsSwitch"
                        android:text="Print after a cash sale" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/rowShopName"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowShopAddress"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowShopPhone"
                        layout="@layout/view_setting_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Setup (commissioning) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/SettingsSectionTitle"
                        android:text="Setup" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:text="Set once when the till is installed. Changing these stops the till working until they are right again." />

                    <include
                        android:id="@+id/rowPosUrl"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowPaymentProvider"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowAffiliateKey"
                        layout="@layout/view_setting_row" />

                    <include
                        android:id="@+id/rowAppId"
                        layout="@layout/view_setting_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
